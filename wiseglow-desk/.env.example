# WiseGlow Desk — configurazione
# Copia questo file in .env e compila i valori. Il file .env non va mai committato.

# I tre segreti qui sotto sono volutamente vuoti: finché restano vuoti  run.py --check  si ferma
# con un messaggio chiaro invece di accettare un valore segnaposto.

# --- Feishu (obbligatori) -----------------------------------------------------
# Dalla console sviluppatori: 凭证与基础信息 (Credentials & Basic Info)
# App ID: inizia con "cli_" (es. cli_a1b2c3d4e5f6g7h8)
FEISHU_APP_ID=
# App Secret: stringa di 32 caratteri
FEISHU_APP_SECRET=
# "feishu" per open.feishu.cn (Cina), "lark" per open.larksuite.com (internazionale)
FEISHU_DOMAIN=feishu

# --- Anthropic (obbligatoria) -------------------------------------------------
# Chiave API creata su https://console.anthropic.com (pagamento a consumo); inizia con "sk-ant-".
# L'accesso con l'abbonamento claude.ai NON è consentito per le app basate sull'Agent SDK.
ANTHROPIC_API_KEY=

# --- Modello e comportamento (opzionali, valori predefiniti mostrati) --------
# Modello Claude usato dal bot
WISEGLOW_MODEL=claude-fable-5-1
# Profondità di ragionamento: low | medium | high | xhigh | max
WISEGLOW_EFFORT=high
# Quando risponde nei gruppi: "mention" = solo se menzionato, in privato o in risposta a un suo messaggio;
# "all" = a ogni messaggio del gruppo (richiede il permesso im:message.group_msg)
WISEGLOW_TRIGGER_MODE=mention
# Consente all'agente lo strumento Bash (sconsigliato salvo necessità)
WISEGLOW_ALLOW_BASH=false

# --- Limiti di spesa e concorrenza (opzionali) --------------------------------
# Budget massimo in dollari per un singolo turno (una richiesta → una risposta)
WISEGLOW_MAX_BUDGET_USD=5.0
# Numero massimo di passaggi (chiamate a strumenti) per turno
WISEGLOW_MAX_TURNS=60
# Quante chat possono essere elaborate in parallelo
WISEGLOW_MAX_PARALLEL_CHATS=2
# Durata massima in secondi di un turno (minimo 30): oltre, il turno viene interrotto e la chat resta libera
WISEGLOW_TURN_TIMEOUT=900
# Elenco di chat_id (oc_...) separati da virgola a cui il bot risponde; vuoto = tutte le chat in cui è presente
WISEGLOW_ALLOWED_CHATS=

# --- Percorsi e log (opzionali) ----------------------------------------------
# Cartella di lavoro (allegati, documenti, sessioni, log); relativa alla cartella del progetto
WISEGLOW_WORKSPACE=workspace
# File dell'identità visiva
WISEGLOW_BRAND=brand/brand.yaml
# Livello di log: DEBUG | INFO | WARNING | ERROR
WISEGLOW_LOG_LEVEL=INFO
# Percorso di LibreOffice se non è in /Applications o nel PATH (per la conversione in PDF)
# WISEGLOW_SOFFICE=/Applications/LibreOffice.app/Contents/MacOS/soffice
